{
  "name": "@appwarden/build-cloudflare-action",
  "version": "1.9.1",
  "description": "Easy-to-use GitHub Action to build Appwarden for deployment to your Cloudflare domain",
  "author": "support@appwarden.io",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/appwarden/build-cloudflare-action/issues"
  },
  "homepage": "https://github.com/appwarden/build-cloudflare-action#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appwarden/build-cloudflare-action.git"
  },
  "keywords": [
    "appwarden",
    "github actions",
    "web3",
    "web security"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "npm run build:action",
    "build:action": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:types": "tsc --noEmit",
    "check:prettier": "prettier --check .",
    "check:ci": "npm run check:types && npm run check:prettier"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "parse-domain": "^8.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "tsup": "9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
